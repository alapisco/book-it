# Copy to .env.local (git-ignored) and uncomment what you need.
# Expo inlines EXPO_PUBLIC_* values into the JS bundle at build time, so
# rebuild (npm run android / ios / build:*) after changing them.

# API base URL. Default: http://10.0.2.2:8000 on the Android emulator,
# http://localhost:8000 on the iOS simulator. Set it for a physical device,
# e.g. your machine's LAN address.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Web app URL, embedded by the Policies tab. Default: http://10.0.2.2:5173
# (Android emulator), http://localhost:5173 (iOS simulator).
# EXPO_PUBLIC_WEB_URL=http://192.168.1.20:5173

# Pin every request to one test session (otherwise use a deep link:
# bookit://login?testSession=<id>).
# EXPO_PUBLIC_TEST_SESSION=appium-worker-1
