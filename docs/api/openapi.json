  "components": {
    "schemas": {
      "AnchorStart": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start_at"
        ],
        "title": "AnchorStart"
      },
      "ChaosConfig": {
        "properties": {
          "latency_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Latency Ms",
            "default": 0
          },
          "error_status": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 599.0,
                "minimum": 500.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Status"
          },
          "error_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Count",
            "description": "Fail only the next N requests; null = all"
          },
          "timeout_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout Ms"
          },
          "expire_tokens": {
            "type": "boolean",
            "title": "Expire Tokens",
            "default": false
          },
          "path_prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path Prefix"
          }
        },
        "type": "object",
        "title": "ChaosConfig"
      },
      "ClockAdvance": {
        "properties": {
          "seconds": {
            "type": "integer",
            "title": "Seconds"
          }
        },
        "type": "object",
        "required": [
          "seconds"
        ],
        "title": "ClockAdvance"
      },
      "ClockSet": {
        "properties": {
          "now": {
            "type": "string",
            "format": "date-time",
            "title": "Now",
            "description": "A value without an offset is taken as UTC"
          },
          "frozen": {
            "type": "boolean",
            "title": "Frozen",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "now"
        ],
        "title": "ClockSet"
      },
      "ClockState": {
        "properties": {
          "now": {
            "type": "string",
            "format": "date-time",
            "title": "Now"
          },
          "frozen": {
            "type": "boolean",
            "title": "Frozen"
          }
        },
        "type": "object",
        "required": [
          "now",
          "frozen"
        ],
        "title": "ClockState"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "FlagMatrix": {
        "properties": {
          "web": {
            "$ref": "#/components/schemas/PlatformFlags"
          },
          "wap": {
            "$ref": "#/components/schemas/PlatformFlags"
          },
          "android": {
            "$ref": "#/components/schemas/PlatformFlags"
          },
          "ios": {
            "$ref": "#/components/schemas/PlatformFlags"
          }
        },
        "type": "object",
        "required": [
          "web",
          "wap",
          "android",
          "ios"
        ],
        "title": "FlagMatrix"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "PlatformFlags": {
        "properties": {
          "login": {
            "type": "boolean",
            "title": "Login"
          },
          "browse_and_book": {
            "type": "boolean",
            "title": "Browse And Book"
          },
          "my_bookings": {
            "type": "boolean",
            "title": "My Bookings"
          },
          "week_calendar": {
            "type": "boolean",
            "title": "Week Calendar"
          },
          "ics_export": {
            "type": "boolean",
            "title": "Ics Export"
          },
          "waitlist": {
            "type": "boolean",
            "title": "Waitlist"
          },
          "qr_check_in": {
            "type": "boolean",
            "title": "Qr Check In"
          },
          "studio_policies": {
            "type": "string",
            "enum": [
              "page",
              "webview"
            ],
            "title": "Studio Policies"
          }
        },
        "type": "object",
        "required": [
          "login",
          "browse_and_book",
          "my_bookings",
          "week_calendar",
          "ics_export",
          "waitlist",
          "qr_check_in",
          "studio_policies"
